#!/usr/bin/ucode -S
// Peers-SS: service + CLI
'use strict';

import * as fs from 'fs';
import { cursor } from 'uci';
import * as U from '/usr/share/peers-ss/util.uc';
import * as S from '/usr/share/peers-ss/secrets.uc';
import * as API from '/usr/share/peers-ss/api.uc';
import * as P from '/usr/share/peers-ss/ping.uc';
import * as PK from '/usr/share/peers-ss/podkop.uc';
import { fp } from '/usr/share/peers-ss/crypto.uc';
import * as E from '/usr/share/peers-ss/engine.uc';
import * as SU from '/usr/share/peers-ss/setup.uc';
import * as ST from '/usr/share/peers-ss/store.uc';
import * as C from '/usr/share/peers-ss/contour.uc';
import { request } from '/usr/share/peers-ss/http.uc';
import * as INV from '/usr/share/peers-ss/invite.uc';
import * as OPS from '/usr/share/peers-ss/ops.uc';

const VERSION = E.VERSION;
U.set_log_echo(false);
U.cleanup_tmp();

function out(s) { print(s, '\n'); }
function fail(s) { warn('peers-ss: ', s, '\n'); exit(1); }

function ask(prompt) {
	print(prompt);
	fs.stdout.flush();
	let l = fs.stdin.read('line');
	return l == null ? null : trim(l);
}

function uci_get(opt, dflt) { return cursor().get('peers-ss', 'main', opt) ?? dflt; }
function uci_set(opt, val) {
	let c = cursor();
	if (val == null) c.delete('peers-ss', 'main', opt); else c.set('peers-ss', 'main', opt, val);
	c.commit('peers-ss');
}

function mask(t) { return t ? substr(t, 0, 6) + '…' + substr(t, -4) : '-'; }

function fmt_date(ts) {
	let t = localtime(+ts);
	return sprintf('%02d.%02d.%04d', t.mday, t.mon, t.year);
}

function need_token() {
	let t = S.get('ss_token');
	if (!t) fail('StealthSurf token is not set (peers-ss token set)');
	return t;
}

// ---- token ----
function token_check(token) {
	let p = API.profile(token);
	if (!p.ok) return { ok: false, status: p.status, message: p.message };
	let c = API.configs(token);
	if (!c.ok) return { ok: false, status: c.status, message: 'GET /configs failed: ' + (c.message ?? c.err ?? '') };
	let v = API.vless_configs(c.data);
	let soonest = null;
	for (let x in v) if (soonest == null || x.expires_at < soonest) soonest = x.expires_at;
	return { ok: true, account: p.data.id, email: p.data.email, vless: length(v), soonest };
}

function cmd_token(args) {
	let sub = args[0] ?? 'show';
	if (sub == 'set') {
		// token only via stdin (never argv: visible in ps/history); spec §4: input is shown as typed
		if (args[1]) fail('pass the token via stdin/prompt, not as an argument');
		let t = ask('StealthSurf token (stlth_…, shown as typed): ');
		if (!t || !match(t, /^stlth_[a-f0-9]{8}_[a-f0-9]{24}$/)) fail('token format: stlth_<8 hex>_<24 hex>');
		let r = token_check(t);
		if (!r.ok) fail(sprintf('token rejected by API (HTTP %d %s)', r.status, r.message ?? ''));
		// spec §4: show beforehand for which bindings this router becomes a follower
		if (uci_get('contour_id') && E.init() && E.refresh_contour()) {
			let x = E.ctx(), fol = [];
			for (let b in C.all_bindings(x.contour)) {
				let pb = C.parse_binding(b);
				if (index(C.binding_routers(x.contour, b), x.rid) >= 0 && pb.account != r.account) push(fol, b);
			}
			if (length(fol)) {
				out('With this token (account ' + r.account + ') the router becomes a FOLLOWER for: ' + join(', ', fol));
				if (lc(ask('Continue? [y/N] ') ?? '') != 'y') fail('cancelled');
			}
		}
		let label = ask('Label (e.g. «Аккаунт Иванова»), empty = account id: ');
		let old = S.get('ss_account');
		let sec = { ...S.load(), ss_token: t, ss_account: r.account, ss_label: label || ('#' + r.account) };
		S.save(sec);
		out(sprintf('Token saved: account %d, vless configs: %d%s', r.account, r.vless, r.soonest ? ', soonest expiry ' + fmt_date(r.soonest) : ''));
		if (old && +old != +r.account) out(sprintf('WARNING: account changed %d -> %d: this router becomes a follower for bindings of account %d', old, r.account, old));
		if (r.vless == 0) out('WARNING: account is empty (no vless configs)');
		U.log('info', sprintf('token set for account %d', r.account));
		return;
	}
	if (sub == 'show') {
		let t = S.get('ss_token');
		if (!t) return out('No StealthSurf token (follower router)');
		out(sprintf('Label: %s\nAccount: %d\nToken: %s', S.get('ss_label') ?? '-', S.get('ss_account'), args[1] == '--reveal' ? t : mask(t)));
		return;
	}
	if (sub == 'check') {
		let r = token_check(need_token());
		if (!r.ok) fail(sprintf('token invalid (HTTP %d %s)', r.status, r.message ?? ''));
		out(sprintf('OK: account %d, vless configs: %d, soonest expiry: %s', r.account, r.vless, r.soonest ? fmt_date(r.soonest) : '-'));
		return;
	}
	if (sub == 'delete') {
		let sec = { ...S.load() };
		delete sec.ss_token; delete sec.ss_account; delete sec.ss_label;
		S.save(sec);
		out('Token deleted: router is now a follower for all bindings');
		U.log('info', 'token deleted');
		return;
	}
	fail('usage: peers-ss token set|show|check|delete');
}

// ---- configs ----
function list_vless(token) {
	let c = API.configs(token);
	if (!c.ok) fail(sprintf('GET /configs failed (HTTP %d)', c.status));
	return sort(API.vless_configs(c.data), (a, b) => a.id - b.id);
}

function cmd_configs() {
	let v = list_vless(need_token());
	if (!length(v)) return out('Account is empty: no vless configs');
	let n = 1;
	for (let c in v)
		out(sprintf('%2d) %-32s id=%-7d loc=%-3d until %s%s', n++, c.title ?? '-', c.id, c.location_id, fmt_date(c.expires_at), c.auto_renewal ? ' (auto-renew)' : ''));
}


// ---- locations ----
function cmd_locations() {
	let t0 = clock(true);
	let l = API.locations(need_token());
	if (!l.ok) fail('GET /locations failed');
	let excl = uci_get('exclude_locations', ['smart', 'RU']);
	if (type(excl) != 'array') excl = [excl];
	let cand = API.candidate_locations(l.data, excl);
	let t1 = clock(true);
	let r = P.rank_locations(cand);
	let t2 = clock(true);
	for (let x in r)
		out(sprintf('%-4s %-22s %8s  %s', x.loc.code, x.loc.title, x.ms != null ? sprintf('%.1f ms', x.ms) : 'n/a', x.method));
	let el = (a, b) => (b[0] - a[0]) + (b[1] - a[1]) / 1e9;
	out(sprintf('%d locations (excluded: %s); API %.2fs, ping %.2fs', length(r), join(',', excl), el(t0, t1), el(t1, t2)));
}

// ---- podkop ----
function selected_cfg() {
	let bind = uci_get('selected_config');
	if (!bind) fail('no config selected (peers-ss config select)');
	let id = +split(bind, ':')[1];
	for (let c in list_vless(need_token())) if (c.id == id) return c;
	fail('selected config not found in account');
}

function print_apply(r) {
	out(sprintf('changed: %s, ok: %s%s', r.changed, r.ok, r.err ? ', error: ' + r.err : ''));
	if (r.diag) out('diagnostics: ' + (r.diag.ok ? 'green' : 'FAIL ' + join(',', r.diag.fails)) + (length(r.diag.warnings ?? []) ? ' (warnings: ' + join(',', r.diag.warnings) + ')' : ''));
	if (r.latency) out(sprintf('latency via vless: %s ms (%s)', r.latency.ms ?? 'n/a', r.latency.method));
}

function cmd_podkop(args) {
	let sub = args[0] ?? 'status';
	if (sub == 'status') {
		let name = PK.section();
		out(sprintf('podkop %s, section %s: %s, proxy sections: %s', PK.version(), name, PK.section_ok(name) ? 'ok' : 'MISSING',
			join(',', PK.proxy_sections())));
		let l = PK.current_link();
		out('current link: ' + (l ? 'set, fingerprint ' + fp(l) : 'none'));
		out('mixed proxy: ' + (PK.mixed_proxy_url() ?? 'disabled'));
		out('sing-box: ' + (PK.sing_box_running() ? 'running' : 'stopped'));
		return;
	}
	if (sub == 'setup') {
		// section is created together with the first link in one commit (peers-ss podkop apply --setup)
		out(sprintf('%J', PK.check_podkop()));
		return;
	}
	if (sub == 'apply') {
		let c = selected_cfg();
		let t0 = time();
		let r = PK.apply_link(c.connection_url, { force: index(args, '--force') >= 0, setup: index(args, '--setup') >= 0 });
		print_apply(r);
		out(sprintf('took %ds', time() - t0));
		return;
	}
	if (sub == 'diag') {
		let d = PK.diagnostics();
		out(sprintf('%J', { ok: d.ok, fails: d.fails, dns: d.dns, sing_box: d.sing_box, nft: d.nft, fakeip: d.fakeip?.fakeip, outbound: d.outbound }));
		let l = PK.latency();
		out(sprintf('latency via vless: %s ms (%s)', l.ms ?? 'n/a', l.method));
		out('tunnel (layer 4): ' + (PK.tunnel_check().ok ? 'ok' : 'FAIL'));
		return;
	}
	fail('usage: peers-ss podkop status|setup|apply [--force] [--setup]|diag');
}

// ---- GitHub token / bot key ----
function cmd_github_token(args) {
	if (args[0] != 'set') fail('usage: peers-ss github-token set   (token from stdin)');
	let t = ask('GitHub token (fine-grained, Contents RW on the state repo; shown as typed): ');
	if (!t || !match(t, /^(github_pat_|ghp_)[A-Za-z0-9_]+$/)) fail('unexpected token format');
	S.set('gh_token', t);
	out('GitHub token saved');
	U.log('info', 'github token replaced');
}

function need_engine() {
	if (!E.init()) fail('router is not registered in a contour (run install.sh)');
	if (!E.refresh_contour()) fail('cannot read contour.json from GitHub: ' + (ST.last_error() ?? ''));
	return E.ctx();
}

function cmd_bot_key(args) {
	if (args[0] != 'set') fail('usage: peers-ss bot-key set   (64 hex from stdin)');
	let k = ask('Bot key (64 hex): ');
	if (!match(k ?? '', /^[0-9a-f]{64}$/)) fail('bot key must be 64 hex chars');
	let x = need_engine();
	let w = ST.update(C.p_contour(x.cid), (c) => ({ ...c, rev: c.rev + 1, settings: { ...c.settings, bot_key: k } }), { message: 'contour: bot key' });
	out(w.ok ? 'bot key saved in contour settings' : 'failed: ' + w.err);
}

// ---- contour (create / dev join) ----
function ask_password(twice) {
	let p = ask('Contour password (shown as typed): ');
	if (!p || length(p) < 8) fail('password: at least 8 characters');
	if (twice && ask('Repeat password: ') != p) fail('passwords differ');
	return p;
}

function cmd_contour(args) {
	let sub = args[0];
	if (sub == 'create') {
		let repo = args[1] ?? fail('usage: peers-ss contour create <owner/repo>');
		let name = ask('Contour name (e.g. client surname): ');
		if (!name || length(name) > 32) fail('name: 1-32 characters');
		let pw = ask_password(true);
		let bind = uci_get('selected_config');
		let cfg = null;
		if (bind) { let id = +split(bind, ':')[1]; for (let c in list_vless(need_token())) if (c.id == id) cfg = c; }
		let r = SU.create_contour(name, pw, repo, bind, cfg);
		if (!r.ok) fail(r.err);
		out(sprintf('Contour created: %s, router openwrt-1 (%s), binding %s', r.cid, r.rid, bind ?? 'none'));
		return;
	}
	if (sub == 'join-dev') {
		// development helper until invites (stage 8): join group/env directly with repo, contour id and password
		let repo = args[1], cid = args[2], gid = args[3], eid = args[4];
		if (!eid) fail('usage: peers-ss contour join-dev <repo> <cid> <group> <env>');
		let gh = S.get('gh_token') ?? fail('set github-token first');
		let pw = ask_password(false);
		let o = SU.open_contour(cid, pw, repo, gh);
		if (!o.ok) fail(o.err);
		let r = SU.register_router(cid, o.key, repo, gh, { group_id: gid, env_id: eid });
		if (!r.ok) fail(r.err);
		out(sprintf('Registered as %s (%s), binding %s', r.name, r.rid, r.binding ?? 'none'));
		return;
	}
	if (sub == 'show') {
		let x = need_engine();
		let c = x.contour;
		out(sprintf('Contour %s «%s» rev %d, this router: %s (%s), binding %s', x.cid, c.name, c.rev, C.router_name(c, x.rid), x.rid, x.binding ?? '-'));
		C.each_env(c, (eid, e, gid) => out(sprintf('  %s/%s «%s» config %s routers: %s', gid ?? 'standalone', eid, e.name, e.config ?? '-',
			join(', ', map(e.routers ?? [], (r) => C.router_name(c, r))))));
		return;
	}
	fail('usage: peers-ss contour create <repo> | show | join-dev <repo> <cid> <group> <env>');
}

// ---- service ----
function cmd_status() {
	let x = need_engine();
	E.load_state();
	let s = E.state();
	out(sprintf('%s (%s) in %s, binding %s, token: %s', C.router_name(x.contour, x.rid), x.rid, x.cid, x.binding ?? '-',
		x.token ? 'account ' + x.acct : 'none (follower)'));
	out(sprintf('status: %s, fail counter: %d, ping via vless: %s ms, last check: %s', s.status ?? '-', s.counter ?? 0,
		s.ping_ms ?? '-', s.last_check ? (ST.now() - s.last_check) + ' s ago' : '-'));
	if (s.layers) out(sprintf('layers: %J', s.layers));
	let r = ST.get(C.p_rotation(x.cid, x.binding));
	if (r.ok) {
		out(sprintf('rotation file rev %d, lock %s, waiting %s, history %d', r.obj.rev, r.obj.lock ? r.obj.lock.by : 'none',
			r.obj.waiting ? 'since ' + r.obj.waiting.since : 'no', length(r.obj.history ?? [])));
		for (let h in slice(r.obj.history ?? [], -3))
			out(sprintf('  %d by %s: server %s -> %s (%s) %s', h.at, C.router_name(x.contour, h.by), h.from_server, h.to_server, h.location, h.reason));
	}
}

function cmd_rotate(args) {
	need_engine();
	E.load_state();
	let dry = index(args, '--dry-run') >= 0;
	let r = E.rotate({ manual: true, dry_run: dry, reason: dry ? 'dry run' : 'manual' });
	E.save_state();
	out(sprintf('%J', r));
}

function cmd_check() {
	if (!E.init()) fail('router is not registered in a contour');
	E.tick();
	cmd_status();
}

function cmd_daemon() {
	U.set_log_echo(false);
	let interval = 45;
	while (true) {
		let t0 = time();
		if (E.init()) {
			try { E.tick(); } catch (e) { U.log('error', 'tick failed: ' + e); }
			interval = E.ctx()?.settings?.check_interval_s ?? 45;
		} else U.log('warn', 'not configured, sleeping');
		U.sleep_s(max(5, interval - (time() - t0)));
	}
}

// ---- config assign (token router): bind a vless config to this router's environment ----
function assign_config(x, cfg) {
	let bind = sprintf('%d:%d', S.get('ss_account'), cfg.id);
	let eo = C.env_of(x.contour, x.rid);
	if (!eo) fail('router is not in any environment');
	let w = ST.update(C.p_contour(x.cid), (c) => {
		let n = { ...c, rev: c.rev + 1 };
		let e = eo.group_id ? n.groups[eo.group_id].envs[eo.env_id] : n.standalone[eo.env_id];
		if (!e) return null;
		if (e.config && e.config != bind) n.archive = [...(n.archive ?? []), { at: ST.now(), group: eo.group_id, env: eo.env_id, config: e.config }];
		e.config = bind;
		return n;
	}, { message: 'contour: assign config ' + bind });
	if (!w.ok || w.aborted) fail('cannot save contour: ' + (w.err ?? 'environment not found'));
	// rotations/<binding>.json always holds the current link (spec §4 B.6)
	let r = ST.get(C.p_rotation(x.cid, bind));
	if (!r.ok && r.missing) {
		let pw = ST.put(C.p_rotation(x.cid, bind), { rev: 1, binding: bind, url: cfg.connection_url, server_id: cfg.server_id,
			location_id: cfg.location_id, history: [], blacklist: {}, reports: {}, triggers: {}, lock: null, updated_at: ST.now() }, null, 'rotation ' + bind + ': initial link');
		if (!pw.ok && !pw.conflict) fail('cannot write rotation file (HTTP ' + pw.status + ')');
	}
	return bind;
}

function choose_config(token) {
	let v = list_vless(token);
	if (!length(v)) { out('WARNING: account is empty — no vless configs'); return null; }
	let n = 1;
	for (let c in v) out(sprintf('  %2d) %-32s until %s', n++, c.title ?? '-', fmt_date(c.expires_at)));
	while (true) {
		let a = ask(sprintf('Config number 1-%d: ', length(v)));
		if (match(a ?? '', /^[0-9]+$/) && +a >= 1 && +a <= length(v)) return v[+a - 1];
		if (a == null) fail('aborted');
		out('wrong number');
	}
}

function cmd_config_assign() {
	let x = need_engine();
	let c = choose_config(need_token());
	if (!c) return;
	let bind = assign_config(x, c);
	out('Assigned ' + (c.title ?? '-') + ' (' + bind + ') to the environment of this router; applying…');
	E.refresh_contour();
	let r = ST.get(C.p_rotation(x.cid, bind));
	if (r.ok) print_apply(PK.apply_link(r.obj.url, { setup: true }));
}

// ---- installer wizard (spec §4, mode A) ----
function ask_nonempty(prompt, re, errmsg) {
	while (true) {
		let a = ask(prompt);
		if (a == null) fail('aborted');
		if (match(a, re)) return a;
		out(errmsg);
	}
}

function choose_podkop_section() {
	let secs = PK.proxy_sections();
	if (!length(secs)) {
		out('No podkop sections with connection_type proxy — creating section «peers_ss».');
		out('Domain/subnet lists for it are set in LuCI → Services → podkop.');
		return 'peers_ss';
	}
	out('podkop proxy sections with a URL link (Peers-SS will replace that link):');
	let n = 1;
	for (let s in secs) out(sprintf('  %d) %s', n++, s));
	let newname = index(secs, 'peers_ss') < 0 ? 'peers_ss' : 'peers_ss_' + (length(secs) + 1);
	out(sprintf('  %d) create new section «%s»', n, newname));
	while (true) {
		let a = ask(sprintf('Section number 1-%d: ', n));
		if (match(a ?? '', /^[0-9]+$/) && +a >= 1 && +a <= n) return +a == n ? newname : secs[+a - 1];
		if (a == null) fail('aborted');
	}
}

function wizard_finish(link) {
	if (link) {
		out('Applying the link to podkop and running diagnostics (up to 60 s)…');
		let r = PK.apply_link(link, { setup: true });
		print_apply(r);
		if (!r.ok) out('WARNING: diagnostics did not pass — check LuCI → podkop → Diagnostics');
	} else out('No config assigned yet: this router works as a follower until a config is assigned (LuCI or `peers-ss config assign`).');
	system('/etc/init.d/peers-ss enable; /etc/init.d/peers-ss restart >/dev/null 2>&1');
	out('Peers-SS service started. LuCI: Services → Peers-SS.');
}

// ---- join wizard (spec §4, mode B) ----
function cmd_join_wizard(code) {
	if (uci_get('contour_id')) fail(sprintf('this router is already in contour %s — run `peers-ss uninstall` first', uci_get('contour_id')));
	let inv = INV.decode(code);
	if (!inv) fail('invalid invite code (must start with PSS1.)');
	out('== Peers-SS: joining contour ' + inv.cid + ' ==');
	let o = null;
	for (let i = 0; i < 5; i++) {
		let pw = ask('Contour password (shown as typed): ');
		if (pw == null) fail('aborted');
		o = SU.open_contour(inv.cid, pw, inv.repo, inv.gh);
		if (o.ok) break;
		if (!o.bad_key) fail('cannot read the contour: ' + o.err);
		out('wrong contour password — try again');
		o = null;
	}
	if (!o) fail('wrong contour password');
	let rid = SU.new_rid();
	let cl = INV.claim(inv.cid, inv.iid, inv.secret, rid);
	if (!cl.ok) fail('invite rejected: ' + cl.err);
	let r = SU.register_router(inv.cid, o.key, inv.repo, inv.gh, { group_id: cl.invite.group, env_id: cl.invite.env }, rid);
	if (!r.ok) fail(r.err + ' (the invite is used up — create a new one)');
	out(sprintf('Registered as %s (%s)%s', r.name, r.rid, r.binding ? ', config ' + r.binding : ', no config in this environment yet'));
	let bacc = r.binding ? C.parse_binding(r.binding).account : null;
	while (true) {
		let t = ask('StealthSurf token stlth_… (Enter = skip, router will be a follower): ');
		if (!t) break;
		if (!match(t, /^stlth_[a-f0-9]{8}_[a-f0-9]{24}$/)) { out('token format: stlth_<8 hex>_<24 hex>'); continue; }
		let tc = token_check(t);
		if (!tc.ok) { out(sprintf('token rejected (HTTP %d) — again or Enter', tc.status)); continue; }
		if (bacc && tc.account != bacc) out(sprintf('WARNING: token account %d differs from the config account %d — this router will be a FOLLOWER', tc.account, bacc));
		let label = ask('Token label: ');
		S.save({ ...S.load(), ss_token: t, ss_account: tc.account, ss_label: label || ('#' + tc.account) });
		break;
	}
	let sec = choose_podkop_section();
	uci_set('podkop_section', sec);
	let link = null;
	if (r.binding) {
		ST.init(inv.repo, inv.gh, o.key);
		let rf = ST.get(C.p_rotation(inv.cid, r.binding));
		if (rf.ok) link = rf.obj.url; else out('WARNING: no current link for this config in the storage yet — it will be applied when available');
	}
	wizard_finish(link);
}

function cmd_wizard() {
	let join = getenv('PEERS_SS_JOIN');
	if (join) return cmd_join_wizard(join);
	if (uci_get('contour_id')) {
		out(sprintf('This router is already in contour %s (%s). Settings kept; service restarted.', uci_get('contour_id'), uci_get('router_id')));
		system('/etc/init.d/peers-ss enable; /etc/init.d/peers-ss restart >/dev/null 2>&1');
		return;
	}
	out('== Peers-SS: new contour (first router) ==');
	let name = ask_nonempty('Contour name (e.g. client surname, 1-32 chars): ', /^.{1,32}$/, 'name: 1-32 characters');
	let pw;
	while (true) {
		pw = ask_nonempty('Contour password (min 8 chars, shown as typed): ', /^.{8,}$/, 'at least 8 characters');
		if (ask('Repeat password: ') == pw) break;
		out('passwords differ, again');
	}
	let repo = ask_nonempty('State repository (owner/peers-ss-state): ', /^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/, 'format: owner/name');
	let gh;
	while (true) {
		gh = ask_nonempty('GitHub fine-grained token (Contents: Read and write on this repo only; shown as typed): ', /^(github_pat_|ghp_)[A-Za-z0-9_]+$/, 'unexpected token format');
		if (substr(gh, 0, 4) == 'ghp_') out('WARNING: classic token — a fine-grained token limited to this repository is recommended');
		let rq = request(sprintf('https://api.github.com/repos/%s', repo), { headers: { Authorization: 'Bearer ' + gh, 'User-Agent': 'peers-ss', Accept: 'application/vnd.github+json' } });
		if (rq.status == 200) break;
		out(rq.status == 0 ? 'GitHub is not reachable from this router (network/DNS)' : sprintf('GitHub: no access to %s with this token (HTTP %d)', repo, rq.status));
	}
	S.set('gh_token', gh);
	let cfg = null, bind = null;
	while (true) {
		let t = ask('StealthSurf token stlth_… (Enter = add later): ');
		if (!t) break;
		if (!match(t, /^stlth_[a-f0-9]{8}_[a-f0-9]{24}$/)) { out('token format: stlth_<8 hex>_<24 hex> — again, or Enter to skip'); continue; }
		let r = token_check(t);
		if (!r.ok) { out(sprintf('token rejected (HTTP %d %s) — again, or Enter to skip', r.status, r.message ?? '')); continue; }
		out(sprintf('Account %d%s, vless configs: %d', r.account, r.email ? ' (' + r.email + ')' : '', r.vless));
		let label = ask('Token label (e.g. «Аккаунт Иванова»): ');
		S.save({ ...S.load(), ss_token: t, ss_account: r.account, ss_label: label || ('#' + r.account) });
		cfg = choose_config(t);
		if (cfg) bind = sprintf('%d:%d', r.account, cfg.id);
		break;
	}
	let sec = choose_podkop_section();
	uci_set('podkop_section', sec);
	let bk = ask('Bot key (64 hex, Enter = set later in LuCI → Notifications): ');
	let res = SU.create_contour(name, pw, repo, bind, cfg);
	if (!res.ok) fail(res.err);
	out(sprintf('Contour %s created: group «peers-ss», environment «среда-1», this router = openwrt-1', res.cid));
	if (match(bk ?? '', /^[0-9a-f]{64}$/)) {
		ST.update(C.p_contour(res.cid), (c) => ({ ...c, rev: c.rev + 1, settings: { ...c.settings, bot_key: bk } }), { message: 'contour: bot key' });
		out('Bot key saved');
	}
	wizard_finish(cfg?.connection_url);
}

function cmd_config(args) {
	if (args[0] == 'select') {
		let v = list_vless(need_token());
		if (!length(v)) fail('account is empty');
		let n = args[1] ?? ask(sprintf('Config number 1-%d: ', length(v)));
		if (!match(n ?? '', /^[0-9]+$/)) fail('wrong number');
		n = +n;
		if (!(n >= 1 && n <= length(v))) fail('wrong number');
		let c = v[n - 1];
		let bind = sprintf('%d:%d', S.get('ss_account'), c.id);
		uci_set('selected_config', bind);
		out(sprintf('Selected: %s (%s)', c.title ?? '-', bind));
		return;
	}
	if (args[0] == 'assign') return cmd_config_assign();
	if (args[0] == 'show' || !args[0]) return out(uci_get('selected_config', '-'));
	fail('usage: peers-ss config select [N] | show');
}

// ---- uninstall (spec §4): files + service + router entry in contour.json; podkop section and its link stay ----
function cmd_uninstall(args) {
	if (index(args, '--yes') < 0 && lc(ask('Remove Peers-SS from this router? podkop and its current link stay. [y/N] ') ?? '') != 'y') fail('cancelled');
	system('/etc/init.d/peers-ss stop >/dev/null 2>&1; /etc/init.d/peers-ss disable >/dev/null 2>&1');
	if (E.init() && E.refresh_contour()) {
		let x = E.ctx();
		let w = ST.update(C.p_contour(x.cid), (c) => {
			if (!c.routers?.[x.rid]) return null;
			let n = json(sprintf('%J', c));
			OPS.remove_router(n, x.rid);
			OPS.bump(n, x.rid);
			return n;
		}, { message: 'contour: ' + C.router_name(x.contour, x.rid) + ' uninstalled' });
		out(w.ok ? 'Removed ' + C.router_name(x.contour, x.rid) + ' from contour ' + x.cid : 'WARNING: could not update contour.json (' + (w.err ?? '') + ')');
		let rr = ST.get_raw(C.p_router(x.cid, x.rid));
		if (rr.ok) ST.delete_raw(C.p_router(x.cid, x.rid), rr.sha, 'router ' + x.rid + ' uninstalled');
	} else out('WARNING: contour not reachable — remove this router in LuCI → Devices on another router');
	let pkg = system('opkg status peers-ss 2>/dev/null | grep -q "^Status:.*installed"') == 0;
	system("sed -i '\\#^/etc/config/peers-ss$#d; \\#^/etc/peers-ss/$#d' /etc/sysupgrade.conf");
	system('rm -rf /etc/peers-ss /tmp/peers-ss /etc/config/peers-ss /etc/rc.d/*peers-ss /tmp/luci-indexcache* /tmp/luci-modulecache');
	if (pkg) system('opkg remove peers-ss >/dev/null 2>&1');
	system('rm -rf /usr/share/peers-ss /usr/share/rpcd/ucode/peers-ss.uc /usr/share/rpcd/acl.d/luci-app-peers-ss.json /usr/share/luci/menu.d/luci-app-peers-ss.json /www/luci-static/resources/view/peers-ss /etc/init.d/peers-ss');
	system('/etc/init.d/rpcd reload >/dev/null 2>&1');
	out('Peers-SS removed. podkop section and its current link were not touched.');
	system('rm -f /usr/bin/peers-ss');
}

function cmd_invite(args) {
	let x = need_engine();
	if (args[0] == 'create') {
		let r = INV.create(x, args[1] || null, args[2] || null, +(args[3] ?? 24));
		if (r.error) fail(r.error);
		out('Invite ' + r.id + ' valid until ' + r.expires_at + ':');
		out(r.command);
		return;
	}
	if (args[0] == 'revoke') { let r = INV.revoke(x, args[1]); if (r.error) fail(r.error); out('revoked'); return; }
	for (let i in INV.list(x).invites) out(sprintf('%s %s/%s until %d %s', i.id, i.group ?? 'standalone', i.env ?? 'new',
		i.expires_at, i.revoked ? 'revoked' : (i.used_by ? 'used by ' + i.used_name : (i.active ? 'active' : 'expired'))));
}

function usage() {
	out('Peers-SS ' + VERSION + '\nusage: peers-ss <command>\n' +
		'  token set|show [--reveal]|check|delete\n  configs\n  config select [N]|assign|show\n  locations\n  podkop status|setup|apply [--force] [--setup]|diag\n  github-token set | bot-key set\n  contour create <repo> | show | join-dev <repo> <cid> <group> <env>\n  status | check | rotate [--dry-run] | daemon\n  invite create <group> [env] [hours] | revoke <id> | list\n  uninstall [--yes]\n  version');
}

let argv = [...ARGV];
let cmd = shift(argv);
switch (cmd) {
case 'token': cmd_token(argv); break;
case 'configs': cmd_configs(); break;
case 'config': cmd_config(argv); break;
case 'locations': cmd_locations(); break;
case 'podkop': cmd_podkop(argv); break;
case 'github-token': cmd_github_token(argv); break;
case 'bot-key': cmd_bot_key(argv); break;
case 'contour': cmd_contour(argv); break;
case 'status': cmd_status(); break;
case 'check': cmd_check(); break;
case 'rotate': cmd_rotate(argv); break;
case 'daemon': cmd_daemon(); break;
case 'wizard': cmd_wizard(); break;
case 'uninstall': cmd_uninstall(argv); break;
case 'invite': cmd_invite(argv); break;
case 'version': out(VERSION); break;
default: usage(); exit(cmd ? 1 : 0);
}
